# =============================================================
# TaxMind Pakistan - Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================

# --- Database (REQUIRED) ---
# Neon (free): postgresql://user:password@ep-xxx.region.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/taxmind?sslmode=require"

# --- AI Document Analysis (REQUIRED for AI features) ---
# OPTION 1: Hugging Face (RECOMMENDED — Free, works in Pakistan, no credit card)
# Get your key: https://huggingface.co/settings/tokens
HF_API_KEY=""
HF_MODEL="Qwen/Qwen2.5-VL-7B-Instruct"
#
# OPTION 2: Google Gemini (Free tier, may not work in Pakistan)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
#
# OPTION 3: xAI Grok (Paid — affordable, strong vision)
XAI_API_KEY=""
XAI_MODEL="grok-4-latest"
#
# OPTION 4: OpenAI (Paid)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
#
# Priority: HF > Gemini > Grok > OpenAI. If one fails, next is tried.

# --- Google OAuth Login (Optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- App URL (Auto-set on Vercel. For local dev: http://localhost:3000) ---
NEXTAUTH_URL="http://localhost:3000"