# =============================================================
# TaxMind Pakistan - Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================

# --- Database (REQUIRED) ---
# Vercel Postgres: postgresql://user:password@host:5432/database?sslmode=require
# Neon (free): postgresql://user:password@ep-xxx.region.neon.tech/neondb?sslmode=require
# Supabase (free): postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/taxmind?sslmode=require"

# --- AI Document Analysis (REQUIRED for AI features) ---
# TaxMind uses AI vision to read salary slips, bank statements, tax returns.
# Set ONE of these (Gemini is recommended — has a free tier):
#
# OPTION 1: Google Gemini (RECOMMENDED — Free tier: 15 requests/min)
# Get your key: https://aistudio.google.com/apikey
# Free models: gemini-2.0-flash (default)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
#
# OPTION 2: xAI Grok (Affordable, strong vision model)
# Get your key: https://console.x.ai/
# Models: grok-4-latest (best vision), grok-3-mini (cheaper)
XAI_API_KEY=""
XAI_MODEL="grok-4-latest"
#
# OPTION 3: OpenAI (Paid — ~$0.15 per 1000 images)
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
#
# Priority: Gemini > Grok > OpenAI. If one fails, it falls through to the next.
# If none are set, document upload works but analysis says "not configured".
# Tax calculator, optimizer, guides, and reports ALL work without AI.

# --- Google OAuth Login (Optional) ---
# Get from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-app.vercel.app/api/auth/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- App URL (Auto-set on Vercel. For local dev: http://localhost:3000) ---
NEXTAUTH_URL="http://localhost:3000"
