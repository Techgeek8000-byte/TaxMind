generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  company       String?
  passwordHash  String   @default("") // empty for OAuth users
  googleId      String?  @unique
  avatar        String?
  role          String   @default("user")
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  failedAttempts Int     @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents       Document[]
  taxCalculations TaxCalculation[]
  auditLogs       AuditLog[]
}

model Document {
  id              String   @id @default(cuid())
  userId          String
  fileName        String
  fileType        String
  fileSize        Int
  filePath        String
  analysisResult  String?
  status          String   @default("uploaded")
  uploadedAt      DateTime @default(now())
  analyzedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaxCalculation {
  id                    String   @id @default(cuid())
  userId                String
  taxYear               String
  filingType            String
  salaryIncome          String?
  businessIncome        String?
  propertyIncome        String?
  capitalGains          String?
  otherIncome           String?
  allowedDeductions     String?
  taxCredits            String?
  grossIncome           Float
  taxableIncome         Float
  taxComputed           Float
  taxCreditsApplied     Float?
  taxPayable            Float
  taxAlreadyPaid        Float    @default(0)
  taxDue                Float
  optimizationStrategies String?
  savingsAchieved       Float?
  originalTax           Float?
  reportGenerated       Boolean  @default(false)
  reportPath            String?
  status                String   @default("draft")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model TaxGuide {
  id        String   @id @default(cuid())
  title     String
  category  String
  content   String
  section   String?
  taxYear   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
